# Salin ke .env lalu isi. File .env tidak pernah di-commit (lihat .gitignore).
# :8081 karena 8080 di mesin dev dipakai laragon; compose juga memetakan host 8081 → container 8080
ADDR=:8081
APP_ENV=development
# Port 5433 di host (compose memetakan 5433 → 5432 container, karena 5432 host dipakai PostgreSQL lokal)
DATABASE_URL=postgres://nusa:nusa_dev_only@127.0.0.1:5433/nusaledger?sslmode=disable

# Minimal 32 byte acak di produksi. Contoh cara membuat: openssl rand -base64 48
JWT_SECRET=dev-only-secret-ganti-di-produksi-minimal-32-byte

# Semua nominal dalam SEN (Rp 1 = 100)
TRANSFER_FEE_SEN=100000
MIN_TRANSFER_SEN=1000000
MAX_TRANSFER_SEN=5000000000

SHUTDOWN_WAIT=30s
DRIFT_CHECK_INTERVAL=60s
